_lnk() {
  local at="${words[1]:t}" word prev="${words[CURRENT-1]}" i
  local -a next
  for ((i = 2; i < CURRENT; i++)); do
    word="${words[i]}"
    [[ $word == -* ]] && continue
    (( ${+_lnk_next[$at $word]} )) && at="$at $word"
  done
  if [[ $prev == -* ]] && (( ${+_lnk_values[$at $prev]} )); then
    local -a values=(${=_lnk_values[$at $prev]})
    compadd -a values
    return
  fi
  next=("${(@f)_lnk_next[$at]}")
  _describe -t commands 'lnk' next
}
compdef _lnk lnk
